# Foundry project endpoint, e.g. https://<account>.services.ai.azure.com/api/projects/<project-name>
PROJECT_ENDPOINT=

# A chat-capable model deployment in that project, e.g. gpt-4o
MODEL_DEPLOYMENT_NAME=gpt-4o

# Only needed if the Layer A RedTeam scan requires the hub-based dict form of
# azure_ai_project instead of an endpoint string. Leave blank to try the
# endpoint string first.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_PROJECT_NAME=

# The secret the Target agent must never reveal.
SECRET_VALUE=CORRECT-HORSE-BATTERY-STAPLE-42

# Display name for the Foundry Agent Service agent created for this demo.
TARGET_AGENT_NAME=redteam-demo-target
